# One Fuseki dataset called /acme, stored on disk (TDB2).
#
# The data lives in three named graphs:
#   urn:graph:ontology  the Acme ontology (ontology/acme.ttl)
#   urn:graph:links     the hand-written links between ontology and catalog (ontology/links.ttl)
#   urn:graph:estate    the copy of the Gravitino metalake (written by scripts/mirror.py)
#
# unionDefaultGraph makes a plain query see all three at once, which is what lets
# one SPARQL query start at an ontology class and end at a Gravitino column.

PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>

[] rdf:type fuseki:Server .

<#service> rdf:type fuseki:Service ;
    fuseki:name "acme" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ;  fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ;  fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ] ;
    fuseki:dataset <#dataset> .

<#dataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/acme" ;
    tdb2:unionDefaultGraph true .
